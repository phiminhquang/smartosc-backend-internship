# Copy to .env and fill all four values with unique local-only secrets.
# Never commit .env or reuse production credentials.
LOCAL_DB_PASSWORD=
# Optional host port used when the backend runs from IntelliJ.
LOCAL_DB_PORT=3307
LOCAL_ADMIN_PASSWORD=
# Generate at least 64 random bytes, e.g. `openssl rand -hex 64`.
LOCAL_JWT_SIGNER_KEY=
# Generate exactly 32 random bytes encoded as Base64, e.g. `openssl rand -base64 32`.
LOCAL_EMAIL_JOB_SECRET_KEY=
# Optional neutral response window for password-reset enumeration resistance.
PASSWORD_RESET_RESPONSE_MIN_DURATION=150ms
PASSWORD_RESET_RESPONSE_JITTER=25ms
