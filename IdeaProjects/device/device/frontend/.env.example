# Base URL cho Backend REST API
# 1. Môi trường Local / Docker Compose:
#    Mặc định '/api' (dùng qua Vite dev proxy hoặc Nginx reverse proxy)
VITE_API_BASE_URL=/api

# 2. Môi trường Render Static Site (Demo cloud):
#    - Khi tạo Static Site lần đầu để lấy frontend hostname:
#      VITE_API_BASE_URL=https://placeholder.invalid/api
#    - Khi Backend Web Service Render đã deploy xong và có hostname thật:
#      VITE_API_BASE_URL=https://<backend-host>.onrender.com/api
